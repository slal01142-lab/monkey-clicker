package com.monkey.clicker

import android.graphics.Bitmap
import android.graphics.Color
import kotlin.math.abs

/**
 * Fruit-catching screen ke liye simple colour-based detection.
 * Bomb = chhota gol kaala blob. Fruit = background se alag saturated blob.
 * Return: monkey ko kis x (pixels) par le jana hai (curX return ho to jagah par raho).
 */
object FruitVision {
    private class Blob(val x: Float, val y: Float)

    fun decide(bmp: Bitmap, curX: Float): Float {
        val sw = 180
        val sh = (bmp.height * sw.toFloat() / bmp.width).toInt()
        val scale = bmp.width.toFloat() / sw
        val small = Bitmap.createScaledBitmap(bmp, sw, sh, true)
        val px = IntArray(sw * sh)
        small.getPixels(px, 0, sw, 0, 0, sw, sh)
        small.recycle()

        val y0 = (sh * Cfg.PLAY_TOP).toInt()
        val y1
