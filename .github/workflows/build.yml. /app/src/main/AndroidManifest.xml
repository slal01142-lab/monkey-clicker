package com.monkey.clicker

/** Saari tunable values yahan hain. Game me kuch galat chale to pehle yahi badlo. */
object Cfg {
    // Gameplay: screen ko kitni der hold karna hai aur do holds ke beech gap (ms)
    const val HOLD_MS = 500L
    const val HOLD_GAP_MS = 700L

    // Fruit game: bomb se kitni door rehna hai (screen width ka fraction)
    const val SAFE_X = 0.18f
    // Fruit/bomb dhundne ka area (screen height ka fraction): upar HUD aur neeche monkey chhod ke
    const val PLAY_TOP = 0.14f
    const val PLAY_BOTTOM = 0.80f
    // Monkey ki height jahan swipe karna hai
    const val MONKEY_Y = 0.86f

    // THEME screen ka back arrow (top-left)
    const val BACK_ARROW_X = 0.07f
    const val BACK_ARROW_Y = 0.06f

    // THEME tile text na mile to yahan tap hoga (bottom-left)
    const val THEME_FALLBACK_X = 0.12f
    const val THEME_FALLBACK_Y = 0.90f
}


