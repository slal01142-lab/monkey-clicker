package com.monkey.clicker

import android.accessibilityservice.AccessibilityService
import android.accessibilityservice.GestureDescription
import android.graphics.Bitmap
import android.graphics.Color
import android.graphics.Path
import android.graphics.PixelFormat
import android.graphics.Rect
import android.os.Handler
import android.os.Looper
import android.util.Log
import android.view.Display
import android.view.Gravity
import android.view.View
import android.view.WindowManager
import android.view.accessibility.AccessibilityEvent
import android.widget.Button
import android.widget.LinearLayout
import android.widget.Toast
import com.google.android.gms.tasks.Tasks
import com.google.mlkit.vision.common.InputImage
import com.google.mlkit.vision.text.TextRecognition
import com.google.mlkit.vision.text.latin.TextRecognizerOptions
import java.util.concurrent.CountDownLatch
import java.util.concurrent.TimeUnit
import kotlin.math.abs

class ClickerService : AccessibilityService() {

    private class Line(val t: String, val box: Rect) {
        val cx get() = box.centerX().toFloat()
        val cy get() = box.centerY().toFloat()
    }

    private val tag = "MonkeyClicker"
    private val mainHandler = Handler(Looper.getMainLooper())
    @Volatile private var running = false
    private var worker: Thread? = null
    private var wm: WindowManager? = null
    private var overlay: View? = null
    private var startBtn: Button? = null
    private var stopBtn: Button? = null
    private val recognizer by lazy { TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS) }

    // bot state
    private var fruitMode = false
    private var fruitX = 0f
    private var lastOcr = 0L
    private var adKind = 0            // 0 = koi nahi, 1 = THEME wala ad, 2 = Claim wala ad
    private var adStart = 0L
    private var adAttempt = 0
    private var lastFallback = 0L
    private var lastHold = 0L

    // ---------------------------------------------------------------- lifecycle
    override fun onServiceConnected() {
        super.onServiceConnected()
        showOverlay()
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {}
    override fun onInterrupt() { stopBot() }

    override fun onDestroy() {
        stopBot()
        removeOverlay()
        super.onDestroy()
    }

    // ---------------------------------------------------------------- overlay (START / STOP)
    private fun showOverlay() {
        if (overlay != null) return
        try {
            val mgr = getSystemService(WINDOW_SERVICE) as WindowManager
            wm = mgr
            val d = resources.displayMetrics.density
            val col = LinearLayout(this).apply {
                orientation = LinearLayout.VERTICAL
                setPadding((3 * d).toInt(), (3 * d).toInt(), (3 * d).toInt(), (3 * d).toInt())
                setBackgroundColor(Color.argb(110, 0, 0, 0))
            }
            fun mk(label: String, color: Int, onClick: () -> Unit) = Button(this).apply {
                text = label
                textSize = 11f
                minHeight = 0; minimumHeight = 0; minWidth = 0; minimumWidth = 0
                setPadding(0, 0, 0, 0)
                setTextColor(Color.WHITE)
                setBackgroundColor(color)
                setOnClickListener { onClick() }
            }
            startBtn = mk("START", Color.rgb(0, 150, 0)) { startBot() }
            stopBtn = mk("STOP", Color.rgb(190, 0, 0)) { stopBot() }
            col.addView(startBtn, LinearLayout.LayoutParams((70 * d).toInt(), (38 * d).toInt()))
            col.addView(stopBtn, LinearLayout.LayoutParams((70 * d).toInt(), (38 * d).toInt()).apply {
                topMargin = (4 * d).toInt()
            })
            val lp = WindowManager.LayoutParams(
                WindowManager.LayoutParams.WRAP_CONTENT,
                WindowManager.LayoutParams.WRAP_CONTENT,
                WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
                PixelFormat.TRANSLUCENT
            )
            lp.gravity = Gravity.END or Gravity.CENTER_VERTICAL
            mgr.addView(col, lp)
            overlay = col
            updateButtons()
        } catch (t: Throwable) {
            Log.e(tag, "overlay fail", t)
        }
    }

    private fun removeOverlay() {
        try { overlay?.let { wm?.removeView(it) } } catch (_: Throwable) {}
        overlay = null
    }

    private fun updateButtons() {
        mainHandler.post {
            startBtn?.alpha = if (running) 0.4f else 1f
            stopBtn?.alpha = if (running) 1f else 0.4f
        }
    }

    private fun toast(msg: String) {
        mainHandler.post { Toast.makeText(this, msg, Toast.LENGTH_SHORT).show() }
    }

    // ---------------------------------------------------------------- start / stop
    private fun startBot() {
        if (running) return
        running = true
        fruitMode = false; adKind = 0; lastHold = 0L; lastOcr = 0L
        toast("Started")
        updateButtons()
        worker = Thread {
            try {
                while (running) {
                    try {
                        step()
                    } catch (e: InterruptedException) {
                        break
                    } catch (t: Throwable) {
                        Log.e(tag, "step error", t)
                        sleepMs(600)
                    }
                }
            } finally {
                running = false
                updateButtons()
            }
        }.also { it.start() }
    }

    private fun stopBot() {
        if (running) toast("Stopped")
        running = false
        worker?.interrupt()
        updateButtons()
    }

    // ---------------------------------------------------------------- main step
    private fun step() {
        val shot = screenshot()
        if (shot == null) { sleepMs(700); return }
        try {
            val w = shot.width
            val h = shot.height
            if (fruitMode) {
                val needOcr = System.currentTimeMillis() - lastOcr > 1200
                if (!needOcr) { handleFruit(shot, w, h); sleepMs(150); return }
                val lines = ocr(shot)
                lastOcr = System.currentTimeMillis()
                if (isFruitScreen(lines, h)) { handleFruit(shot, w, h); sleepMs(150); return }
                fruitMode = false
                handleScreens(lines, w, h)
                return
            }
            val lines = ocr(shot)
            lastOcr = System.currentTimeMillis()
            handleScreens(lines, w, h)
        } finally {
            shot.recycle()
        }
    }

    private fun handleScreens(lines: List<Line>, w: Int, h: Int) {
        val now = System.currentTimeMillis()
        val all = lines.joinToString(" | ") { it.t }

        // Ad chal raha hai: sirf countdown khatam hone ka wait + cross
        if (adKind != 0) {
            val done = if (adKind == 1) all.contains("get more") else all.contains("claimed")
            if (!done && now - adStart < 80_000) {
                handleAd(lines, w, h, now)
                sleepMs(500)
                return
            }
            adKind = 0
        }

        // Fruit catching screen
        if (isFruitScreen(lines, h)) {
            fruitMode = true
            fruitX = w / 2f
            return
        }

        // Fruit game over -> hamesha Try Again (Quit kabhi nahi)
        find(lines, "try again")?.let { tapLine(it); sleepMs(1200); return }

        // "Claimed" screen -> Continue (No Thanks nahi)
        if (all.contains("claimed")) {
            find(lines, "continue")?.let { tapLine(it); sleepMs(1200) }
            return
        }

        // Gem reward screen -> Claim (Cancel nahi), phir ad
        word(lines, "claim")?.let {
            tapLine(it)
            startAd(2, now)
            sleepMs(1200)
            return
        }

        // "Do you want to continue?" -> NO THANKS (Watch Ad nahi)
        if (all.contains("do you want") || (all.contains("no thanks") && all.contains("watch"))) {
            find(lines, "no thanks")?.let { tapLine(it); sleepMs(1200) }
            return
        }

        // Game Over -> RESTART (Skip Level nahi)
        find(lines, "restart")?.let { tapLine(it); sleepMs(1200); return }

        // Level Completed -> THEME tile (NEXT nahi), phir ad
        if (all.contains("completed")) {
            val theme = find(lines, "theme")
            if (theme != null) tapLine(theme) else tap(w * Cfg.THEME_FALLBACK_X, h * Cfg.THEME_FALLBACK_Y)
            startAd(1, now)
            sleepMs(1200)
            return
        }

        // Theme selection screen -> back arrow (top-left)
        if (all.contains("get more")) {
            tap(w * Cfg.BACK_ARROW_X, h * Cfg.BACK_ARROW_Y)
            sleepMs(1200)
            return
        }

        // Main menu -> Play
        lines.firstOrNull { it.t == "play" }?.let { tapLine(it); sleepMs(1200); return }

        // "Hold TO Jump" screen -> tap karke game start
        if (all.contains("hold") && all.contains("jump")) {
            tap(w / 2f, h / 2f)
            lastHold = 0L
            sleepMs(900)
            return
        }

        // Gameplay: screen hold karo (monkey agle box par kudta hai)
        if (now - lastHold >= Cfg.HOLD_GAP_MS) {
            gesture(w * 0.5f, h * 0.6f, w * 0.5f, h * 0.6f, Cfg.HOLD_MS)
            lastHold = System.currentTimeMillis()
        } else {
            sleepMs(150)
        }
    }

    private fun startAd(kind: Int, now: Long) {
        adKind = kind
        adStart = now
        adAttempt = 0
        lastFallback = now
    }

    // ---------------------------------------------------------------- ad handling
    private fun handleAd(lines: List<Line>, w: Int, h: Int, now: Long) {
        // Countdown abhi chal raha hai? (chhota number ya "reward in")
        val counting = lines.any {
            Regex("^\\d{1,2}$").matches(it.t) || it.t.contains("reward in")
        }
        if (counting) return

        // Cross / close button
        val crossChars = setOf("x", "\u00d7", "\u2715", "\u2716", "\u2717", "\u274c", "\u2a2f", "\u0445")
        val cross = lines.firstOrNull {
            val s = it.t.replace(" ", "")
            (s in crossChars && it.box.width() < w * 0.15f) || s == "close" || s == "skipad" || s == "skip"
        }
        if (cross != null) {
            tapLine(cross)
            sleepMs(1000)
            return
        }

        // Cross OCR se nahi mila: kuch der baad fallback (Back, top-right, top-left)
        if (now - adStart > 8_000 && now - lastFallback > 3_000) {
            lastFallback = now
            when (adAttempt++ % 3) {
                0 -> performGlobalAction(GLOBAL_ACTION_BACK)
                1 -> tap(w * 0.94f, h * 0.06f)
                else -> tap(w * 0.06f, h * 0.06f)
            }
        }
    }

    // ---------------------------------------------------------------- fruit game
    private fun isFruitScreen(lines: List<Line>, h: Int): Boolean {
        val all = lines.joinToString(" | ") { it.t }
        if (all.contains("try again") || all.contains("game over") || all.contains("claim")) return false
        val re = Regex("\\b\\d{1,3}\\s*/\\s*\\d{2,3}\\b")
        return lines.any { re.containsMatchIn(it.t) && it.box.top < h * 0.25f }
    }

    private fun handleFruit(bmp: Bitmap, w: Int, h: Int) {
        val target = FruitVision.decide(bmp, fruitX)
        val dist = abs(target - fruitX)
        if (dist < w * 0.03f) return
        val y = h * Cfg.MONKEY_Y
        val dur = (dist * 0.25f).toLong().coerceIn(80L, 400L)
        gesture(fruitX, y, target, y, dur)
        fruitX = target
    }

    // ---------------------------------------------------------------- helpers: find / tap
    private fun find(lines: List<Line>, vararg keys: String): Line? =
        lines.firstOrNull { l -> keys.any { l.t.contains(it) } }

    private fun word(lines: List<Line>, wd: String): Line? {
        val re = Regex("\\b$wd\\b")
        return lines.firstOrNull { re.containsMatchIn(it.t) }
    }

    private fun tapLine(l: Line) = tap(l.cx, l.cy)

    private fun tap(x: Float, y: Float) = gesture(x, y, x, y, 70)

    private fun gesture(x1: Float, y1: Float, x2: Float, y2: Float, dur: Long) {
        val p = Path()
        p.moveTo(x1.coerceAtLeast(0f), y1.coerceAtLeast(0f))
        if (x1 != x2 || y1 != y2) p.lineTo(x2.coerceAtLeast(0f), y2.coerceAtLeast(0f))
        val g = GestureDescription.Builder()
            .addStroke(GestureDescription.StrokeDescription(p, 0, dur.coerceAtLeast(1L)))
            .build()
        val latch = CountDownLatch(1)
        val ok = dispatchGesture(g, object : AccessibilityService.GestureResultCallback() {
            override fun onCompleted(gestureDescription: GestureDescription?) { latch.countDown() }
            override fun onCancelled(gestureDescription: GestureDescription?) { latch.countDown() }
        }, null)
        if (ok) latch.await(dur + 2000, TimeUnit.MILLISECONDS)
    }

    private fun sleepMs(ms: Long) { Thread.sleep(ms) }

    // ---------------------------------------------------------------- helpers: screenshot / OCR
    private fun screenshot(): Bitmap? {
        var result: Bitmap? = null
        val latch = CountDownLatch(1)
        takeScreenshot(Display.DEFAULT_DISPLAY, mainExecutor, object : AccessibilityService.TakeScreenshotCallback {
            override fun onSuccess(r: AccessibilityService.ScreenshotResult) {
                try {
                    val hb = r.hardwareBuffer
                    val hw = Bitmap.wrapHardwareBuffer(hb, r.colorSpace)
                    result = hw?.copy(Bitmap.Config.ARGB_8888, false)
                    hw?.recycle()
                    hb.close()
                } catch (t: Throwable) {
                    Log.e(tag, "screenshot decode", t)
                }
                latch.countDown()
            }

            override fun onFailure(errorCode: Int) { latch.countDown() }
        })
        latch.await(3, TimeUnit.SECONDS)
        return result
    }

    private fun ocr(bmp: Bitmap): List<Line> {
        val sc = 0.5f
        val small = Bitmap.createScaledBitmap(bmp, (bmp.width * sc).toInt(), (bmp.height * sc).toInt(), true)
        val out = ArrayList<Line>()
        try {
            val res = Tasks.await(recognizer.process(InputImage.fromBitmap(small, 0)), 8, TimeUnit.SECONDS)
            for (b in res.textBlocks) for (l in b.lines) {
                val r = l.boundingBox ?: continue
                out.add(
                    Line(
                        l.text.lowercase().trim(),
                        Rect((r.left / sc).toInt(), (r.top / sc).toInt(), (r.right / sc).toInt(), (r.bottom / sc).toInt())
                    )
                )
            }
        } finally {
            small.recycle()
        }
        return out
    }
}


